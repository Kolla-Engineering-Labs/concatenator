{
  "name": "concatenator",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "concatenator": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run ui\"",
    "server": "tsx server.ts",
    "ui": "vite",
    "dev:cli": "tsx src/cli/index.ts",
    "build": "vite build && npm run build:assets",
    "build:assets": "tsx scripts/build-web-assets.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist src/cli/web-assets.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "build:exe": "npx tsx scripts/build-sea.js",
    "build:manifest": "node scripts/generate-manifest.js",
    "test:release": "tsx scripts/verify-release-candidate.ts",
    "pre-release": "npm run test:release",
    "version": "changeset version && node ./.changeset/fix-changelog.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/jspdf": "1.3.3",
    "@types/jszip": "^3.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "commander": "14.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "js-tiktoken": "^1.0.21",
    "jspdf": "4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "micromatch": "^4.0.8",
    "motion": "^12.23.24",
    "posthog-js": "^1.369.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@codecov/vite-plugin": "^2.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^29.0.2",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "undici": "^7.24.0",
    "dompurify": ">=3.4.0",
    "postcss": "^8.5.10",
    "ip-address": ">=10.1.1"
  }
}
